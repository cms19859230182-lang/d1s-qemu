From: cms19859230182-lang <276597748+cms19859230182-lang@users.noreply.github.com>
Subject: [PATCH] target/riscv: back the unmodelled T-Head CSRs with plain storage

target/riscv: back the unmodelled T-Head CSRs with plain storage

Firmware for the D1s reads and writes a number of T-Head-specific CSRs
that QEMU does not implement (mxstatus, mhcr, mcor, mhint, the extended
performance counters and a few more).  On real hardware those accesses
succeed; under QEMU they raised an illegal instruction and the firmware
died during early init.

Keep the 0x5c1-0x5df, 0x7c0-0x7ff, 0x9c0-0x9df and 0xfc0-0xfc1 ranges
as plain per-CSR read/write storage.  mxstatus reports UCME, THEADISAEE
and MAEE on its first read so software takes the T-Head paths; after
that it behaves like the rest.  The ranges are listed once and expanded
at first use instead of being spelled out as a hundred table entries.

Also declare the d1s paging flag in cpu.h and have sxstatus report MAEE
only when it is set, which it is only for the d1s machine.

AI assistance: this change was written with help from Grok and reviewed
and tested by a human.
---
 target/riscv/cpu.h               |   7 +++++++
 target/riscv/th_csr.c            | 198 +++++++++++++++++++++++++--
 2 files changed, 203 insertions(+), 2 deletions(-)

diff --git a/target/riscv/cpu.h b/target/riscv/cpu.h
--- a/target/riscv/cpu.h
+++ b/target/riscv/cpu.h
@@ -983,5 +983,12 @@
 /* In th_csr.c */
 extern const RISCVCSR th_csr_list[];
 
+/*
+ * Set by machines that expose the D1s paging attribute bits in PTE[63:59]
+ * (MAEE).  When false, which is the default for every upstream machine,
+ * those bits are treated as reserved exactly as before.
+ */
+extern bool riscv_thead_maee;
+
 const char *priv_spec_to_str(int priv_version);
 #endif /* RISCV_CPU_H */
diff --git a/target/riscv/th_csr.c b/target/riscv/th_csr.c
--- a/target/riscv/th_csr.c
+++ b/target/riscv/th_csr.c
@@ -21,6 +21,7 @@
 #include "cpu_vendorid.h"
 
 #define CSR_TH_SXSTATUS 0x5c0
+#define CSR_TH_MXSTATUS 0x7c0
 
 /* TH_SXSTATUS bits */
 #define TH_SXSTATUS_UCME        BIT(16)
@@ -36,6 +37,12 @@
     return RISCV_EXCP_ILLEGAL_INST;
 }
 
+/* The 0x7c0/0x9c0/0xfc0 ranges are M-mode only; S-mode access traps. */
+static RISCVException m_mode(CPURISCVState *env, int csrno)
+{
+    return env->priv == PRV_M ? RISCV_EXCP_NONE : RISCV_EXCP_ILLEGAL_INST;
+}
+
 static bool test_thead_mvendorid(RISCVCPU *cpu)
 {
     return cpu->cfg.mvendorid == THEAD_VENDOR_ID;
@@ -44,16 +51,203 @@
 static RISCVException read_th_sxstatus(CPURISCVState *env, int csrno,
                                        target_ulong *val)
 {
-    /* We don't set MAEE here, because QEMU does not implement MAEE. */
-    *val = TH_SXSTATUS_UCME | TH_SXSTATUS_THEADISAEE;
+    /*
+     * Report MAEE together with UCME and THEADISAEE when the machine
+     * implements the D1s paging attribute bits (see cpu_helper.c), so that
+     * the firmware takes the T-Head page-table path.  Every other machine
+     * leaves these bits out, exactly as before.
+     */
+    *val = TH_SXSTATUS_UCME | TH_SXSTATUS_THEADISAEE |
+           (riscv_thead_maee ? TH_SXSTATUS_MAEE : 0);
+    return RISCV_EXCP_NONE;
+}
+
+/*
+ * T-Head-specific M-mode CSRs that QEMU does not model: mxstatus, mhcr,
+ * mcor, mhint, the extended performance counter registers and a few more.
+ * On the D1s the firmware reads and writes them without probing first, so
+ * rather than raising an illegal instruction on each access they are kept
+ * as plain per-CSR storage.  They behave as a superset of what a real C906
+ * accepts.
+ *
+ * The ranges are written out once, through a small macro, instead of
+ * listing every register: 0x5c1-0x5df (S-mode), 0x7c0-0x7ff (M-mode),
+ * 0x9c0-0x9df (performance counters) and 0xfc0-0xfc1 (identification).
+ */
+#define TH_CSR_STORE_ENTRY(num, cname, pred)                        \
+    {                                                               \
+        .csrno = (num),                                             \
+        .insertion_test = test_thead_mvendorid,                     \
+        .csr_ops = { (cname), (pred), read_th_csr_store,            \
+                     write_th_csr_store },                          \
+    }
+
+/* Backing store, indexed by CSR number.  Index 0 is never registered. */
+static target_ulong th_csr_store[CSR_TABLE_SIZE];
+
+static RISCVException read_th_csr_store(CPURISCVState *env, int csrno,
+                                        target_ulong *val)
+{
+    /*
+     * mxstatus reports the available T-Head extensions on the first read;
+     * after that it is ordinary read/write storage, so a value written by
+     * the guest is read back unchanged.
+     */
+    if (csrno == CSR_TH_MXSTATUS && th_csr_store[csrno] == 0) {
+        th_csr_store[csrno] = TH_SXSTATUS_UCME | TH_SXSTATUS_THEADISAEE |
+                              TH_SXSTATUS_MAEE;
+    }
+
+    *val = th_csr_store[csrno];
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException write_th_csr_store(CPURISCVState *env, int csrno,
+                                         target_ulong val, uintptr_t ra)
+{
+    th_csr_store[csrno] = val;
     return RISCV_EXCP_NONE;
 }
 
